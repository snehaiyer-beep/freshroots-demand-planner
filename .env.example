# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Only for `npm run migrate`: Supabase → Connect → Session pooler URI (contains the DB password)
SUPABASE_DB_URL=

# Cron auth (Vercel sends "Authorization: Bearer $CRON_SECRET")
CRON_SECRET=

# Anthropic (optional - template reasons are used when missing)
ANTHROPIC_API_KEY=

# Zoho Inventory, India DC (optional - mock mode when any is missing)
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORG_ID=

# Seed script: comma-separated emails to allow-list (e.g. raghav@freshroots.in)
SEED_ALLOWED_EMAILS=

# Skip the login everywhere (local and deployed). Remove to require login again.
AUTH_DISABLED=
# Name recorded as approver in local mode
LOCAL_USER_EMAIL=
